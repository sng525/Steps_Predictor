   "source": [
    "num_dfs = len(dfs)\n",
    "fig, axes = plt.subplots(1, num_dfs, figsize=(5 * num_dfs, 6)) \n",
    "\n",
    "for ax, (name, df) in zip(axes, dfs.items()):\n",
    "    sns.histplot(data=df, x='day', y='value', ax=ax)\n",
    "    ax.set_title(f'Scatter Plot for {name}')  \n",
    "    ax.grid(True) \n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  }
